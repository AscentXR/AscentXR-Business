# ======================
# Ascent XR Backend Configuration
# ======================
# Copy this file to .env and fill in real values

# Server Configuration
PORT=3000
NODE_ENV=development

# Authentication is handled by Firebase. The variables below are LOCAL-DEVELOPMENT
# ONLY and must NEVER be set in a deployed environment — the server refuses to boot
# in production if any of them are present.
#
# ALLOW_INSECURE_AUTH=true  -> accepts Firebase JWTs WITHOUT verifying their signature
#                              (only when NODE_ENV is not "production"). Leave UNSET.
# DISABLE_RATE_LIMIT=true   -> turns off API rate limiting. Leave UNSET.
# ALLOW_INSECURE_AUTH=
# DISABLE_RATE_LIMIT=

# Database (PostgreSQL)
DATABASE_URL=postgresql://ascentxr_user:your_password@localhost:5432/ascentxr

# Redis Cache
REDIS_URL=redis://localhost:6379

# LinkedIn API
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_CALLBACK_URL=http://localhost:3000/api/linkedin/callback

# CRM API (external)
CRM_API_URL=https://web-production-f0ae1.up.railway.app
CRM_API_KEY=your_crm_api_key

# Session
SESSION_SECRET=your_session_secret_key_here

# File Storage
UPLOAD_DIR=./uploads
DOCUMENTS_DIR=./documents
EXPORT_DIR=./exports
BACKUP_DIR=~/backups

# Email Notifications (Resend - https://resend.com, free tier: 100/day)
RESEND_API_KEY=re_your_resend_api_key
NOTIFICATION_EMAILS=jim@ascentxr.com,nick@ascentxr.com
EMAIL_FROM=Ascent XR <notifications@ascentxr.com>
FRONTEND_URL=http://localhost:5173

# AI Agent Execution (optional - system works without it via Claude Code)
ANTHROPIC_API_KEY=sk-ant-your_api_key

# FTP Deployment (use env vars, never hardcode)
FTP_HOST=your_ftp_host
FTP_USER=your_ftp_user
FTP_PASS=your_ftp_password
